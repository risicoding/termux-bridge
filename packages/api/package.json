{
  "name": "@termux-bridge/api",
  "version": "0.1.0",
  "description": "Core API abstractions for interacting with @termux-bridge/server",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": {
        "import": "./dist/types.d.ts",
        "require": "./dist/types.d.cts"
      },
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./schema": {
      "types": {
        "import": "./dist/schema.d.ts",
        "require": "./dist/schema.d.cts"
      },
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@termux-bridge/core": "workspace:*",
    "@termux-bridge/error": "workspace:*",
    "@termux-bridge/typescript-config": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "ky": "^2.1.0"
  }
}
